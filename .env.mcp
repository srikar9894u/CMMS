# MCP Servers Environment Configuration
# Copy this file to .env.mcp.local and customize for your environment

# ============================================
# DATABASE CONFIGURATION
# ============================================

# SQLite
SQLITE_DB_PATH=/data/database.sqlite

# PostgreSQL (when migrated)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cmms
POSTGRES_USER=cmms_user
POSTGRES_PASSWORD=cmms_password
POSTGRES_READ_ONLY=true

# ============================================
# FILESYSTEM CONFIGURATION
# ============================================

# Allowed paths for filesystem MCP (comma-separated)
FILESYSTEM_ALLOWED_PATHS=/workspace,/data,/logs

# ============================================
# GIT CONFIGURATION
# ============================================

# Git repository path
GIT_REPO_PATH=/repo

# ============================================
# GITHUB CONFIGURATION (Optional)
# ============================================

# GitHub Personal Access Token (for GitHub MCP)
# Generate at: https://github.com/settings/tokens
# GITHUB_TOKEN=your_github_token_here

# GitHub Repository
# GITHUB_REPO=your-username/your-repo

# ============================================
# PLAYWRIGHT CONFIGURATION
# ============================================

# Headless mode
PLAYWRIGHT_HEADLESS=true

# Browser (chromium, firefox, webkit)
PLAYWRIGHT_BROWSER=chromium

# Base URL for testing
PLAYWRIGHT_BASE_URL=http://cmms-frontend

# Viewport size
PLAYWRIGHT_VIEWPORT_WIDTH=1280
PLAYWRIGHT_VIEWPORT_HEIGHT=720

# Screenshot on failure
PLAYWRIGHT_SCREENSHOT_ON_FAILURE=true

# Video recording
PLAYWRIGHT_VIDEO_RECORDING=false

# ============================================
# FETCH MCP CONFIGURATION
# ============================================

# Request timeout (ms)
FETCH_TIMEOUT=30000

# Max redirects
FETCH_MAX_REDIRECTS=5

# User agent
FETCH_USER_AGENT=CMMS-MCP-Fetch/1.0

# ============================================
# MEMORY MCP CONFIGURATION
# ============================================

# Memory storage path
MEMORY_STORAGE=/data/memory.json

# Max memory entries
MEMORY_MAX_ENTRIES=10000

# ============================================
# TIME MCP CONFIGURATION
# ============================================

# Default timezone
DEFAULT_TIMEZONE=UTC

# ============================================
# MCP GATEWAY CONFIGURATION
# ============================================

# Gateway port
MCP_GATEWAY_PORT=8080

# Enable CORS
MCP_GATEWAY_CORS=true

# ============================================
# LOGGING
# ============================================

# Log level (debug, info, warn, error)
MCP_LOG_LEVEL=info

# Log format (json, text)
MCP_LOG_FORMAT=json
